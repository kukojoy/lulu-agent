# Optional Tavily API key for web_search and web_extract
TAVILY_API_KEY=

# Model request timeout in seconds
MODEL_TIMEOUT_SECONDS=60

# Number of retry attempts after retryable model request failures
MODEL_MAX_RETRIES=3

# Global safety profile for native file/shell tools
# Supported values: read_only, workspace_write, approval_required, trusted
SAFETY_PROFILE=workspace_write
